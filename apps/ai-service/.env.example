# ============================================================
# LabCermat AI Service — Environment Variables
# ============================================================
# Salin ke .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository.
# ============================================================

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
APP_VERSION=1.0.0
APP_PORT=8000

# ============================================================
# BACKEND (untuk internal callback jika diperlukan)
# ============================================================
BACKEND_URL=http://localhost:3001

# ============================================================
# AZURE AI SERVICES (Sprint 7 — placeholder Sprint 1)
# ============================================================
AZURE_OPENAI_ENDPOINT=https://[resource-name].openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://[resource-name].cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-document-intelligence-key

AZURE_AI_SEARCH_ENDPOINT=https://[resource-name].search.windows.net
AZURE_AI_SEARCH_KEY=your-ai-search-key
AZURE_AI_SEARCH_INDEX=labcermat-sop

AZURE_BLOB_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=[account];AccountKey=[key];EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_NAME=labcermat-documents

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
