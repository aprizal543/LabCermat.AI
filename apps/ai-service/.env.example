# ============================================================
# LabCermat AI Service — Environment Variables
# ============================================================
# Salin ke .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository.
# ============================================================

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
APP_VERSION=1.0.0
APP_PORT=8000

# ============================================================
# BACKEND (untuk internal callback jika diperlukan)
# ============================================================
BACKEND_URL=http://localhost:3001

# ============================================================
# AI MODE (Sprint 7 — QC Anomaly ML Artifact Inference)
# ============================================================
# rule_based         — Sprint 6 rule-based logic (default, no dependencies)
# azure_ml_artifact  — in-process inference dari Azure ML trained artifact
AI_MODE=rule_based

# Path ke folder berisi artifacts hasil `az ml model download`:
#   model.pkl, label_mapping.json
# Contoh: AZURE_ML_MODEL_DIR=./app/qc-anomaly-detector
# Biarkan kosong jika memakai AI_MODE=rule_based
AZURE_ML_MODEL_DIR=

# ============================================================
# AZURE OPENAI / AI FOUNDRY (Sprint 8)
# ============================================================
# Endpoint Azure OpenAI resource.
# Format: https://<resource-name>.openai.azure.com/
# Didapat dari: Azure Portal → Azure OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=

# API key untuk Azure OpenAI resource (Key 1 atau Key 2)
AZURE_OPENAI_API_KEY=

# API version yang digunakan. Gunakan versi stabil terbaru.
# Rekomendasi: 2024-02-01
AZURE_OPENAI_API_VERSION=2024-02-01

# Nama deployment model GPT untuk chat completion.
# Dibuat di Azure AI Foundry → Deployments → Deploy model → gpt-4o-mini
# Nama deployment bebas, contoh: gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# Nama deployment model Embedding untuk vector search.
# Dibuat di Azure AI Foundry → Deployments → Deploy model → text-embedding-3-small
# Nama deployment bebas, contoh: text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# ============================================================
# AZURE AI DOCUMENT INTELLIGENCE (Sprint 8)
# ============================================================
# Resource: docint-labcermat (region: japanwest)
# Tier: Free F0 (500 hal/bulan) — cukup untuk hackathon
# Endpoint format: https://<resource-name>.cognitiveservices.azure.com/
# Didapat dari: Azure Portal → Document Intelligence resource → Keys and Endpoint
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://docint-labcermat.cognitiveservices.azure.com/

# API key untuk Azure AI Document Intelligence (Key 1)
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ============================================================
# AZURE AI SEARCH (Sprint 8)
# ============================================================
# Resource: search-labcermat (region: eastasia)
# Tier: Free (1 index, 50 MB) — cukup untuk MVP
# Mode: Keyword/BM25 only — vector/embedding search ditunda
# Endpoint format: https://<service-name>.search.windows.net
# Didapat dari: Azure Portal → AI Search resource → Overview → Url
AZURE_AI_SEARCH_ENDPOINT=https://search-labcermat.search.windows.net

# Admin key untuk Azure AI Search (untuk indexing + search).
# Didapat dari: Azure Portal → AI Search resource → Keys → Primary admin key
AZURE_AI_SEARCH_KEY=

# Nama index di Azure AI Search untuk dokumen SOP.
# Dibuat otomatis oleh AI service saat pertama kali dokumen diindeks.
AZURE_AI_SEARCH_INDEX_NAME=labcermat-sop-index

# ============================================================
# GENERATIVE AI PROVIDER (Sprint 8 Langkah 7)
# ============================================================
# Pilih provider untuk jawaban SOP generatif:
#   template_fallback  — template BM25 saja, tanpa LLM (default aman)
#   groq               — Groq LLaMA (gratis, cepat, source-grounded)
#
# Jika GROQ_API_KEY kosong atau provider bukan "groq", fallback ke template_fallback.
AI_GENERATIVE_PROVIDER=template_fallback

# Timeout dalam detik untuk Groq API call.
AI_GENERATIVE_TIMEOUT_SECONDS=20

# ── Groq ──────────────────────────────────────────────────────
# API key dari https://console.groq.com → API Keys
# Biarkan kosong untuk mode template_fallback
GROQ_API_KEY=

# Model Groq yang digunakan. Rekomendasi: llama-3.1-8b-instant (cepat, gratis)
# Alternatif: llama-3.3-70b-versatile, gemma2-9b-it
GROQ_MODEL=llama-3.1-8b-instant

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
