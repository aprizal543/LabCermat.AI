# ============================================================
# LabCermat Backend — Environment Variables
# ============================================================
# Salin ke .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository.
# ============================================================

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
PORT=3001
APP_VERSION=1.0.0

# ============================================================
# DATABASE — SUPABASE POSTGRESQL
# ============================================================
# DATABASE_URL  : Pakai connection pooler Supabase (port 6543)
#                 Dipakai Prisma Client saat runtime
# DIRECT_URL    : Koneksi langsung ke PostgreSQL (port 5432)
#                 Dipakai prisma migrate dev — TIDAK melalui pooler
# ============================================================
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ============================================================
# SUPABASE
# ============================================================
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================
# AI SERVICE
# ============================================================
AI_SERVICE_URL=http://localhost:8000

# ============================================================
# CORS
# ============================================================
CORS_ORIGIN=http://localhost:5175
