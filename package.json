{
  "name": "labcermat-production",
  "version": "1.0.0",
  "private": true,
  "description": "LabCermat — Platform Workflow Laboratorium Klinik",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "typecheck": "pnpm --filter shared-types typecheck && pnpm --filter backend typecheck && pnpm --filter frontend typecheck",
    "typecheck:shared": "pnpm --filter shared-types typecheck",
    "typecheck:backend": "pnpm --filter backend typecheck",
    "typecheck:frontend": "pnpm --filter frontend typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
